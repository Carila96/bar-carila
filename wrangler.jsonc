{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bar-carila",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/health",
      "/carila"
    ]
  }
}
